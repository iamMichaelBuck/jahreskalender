{
  "name": "jahreskalender",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev --port 8788",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler pages dev --port 8788",
    "typecheck": "tsc -b",
    "db:migrate:local": "wrangler d1 migrations apply kalender-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply kalender-db --remote",
    "deploy": "npm run build && wrangler pages deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  }
}
